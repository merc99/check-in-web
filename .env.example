# Copy to .env.local.

# Supabase project. The anon key is public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# mock = in-memory demo data (default). supabase = the real project.
NEXT_PUBLIC_DATA_SOURCE=mock

# Fake crew activity in mock mode. On by default in dev; set true to keep it in a production build.
# NEXT_PUBLIC_SIMULATE_LIVE=true
