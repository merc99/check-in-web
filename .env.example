# Copy to .env.local. Nothing is required: the app runs on built-in demo data.

# Fake crew activity (arrivals and hearts). On unless set to false.
# NEXT_PUBLIC_SIMULATE_LIVE=false

# AI demo (app/api/ai): the weekly recap and smart check-in. Without a key, both use a built-in template.
# Set the real key in Vercel → Project → Settings → Environment Variables; never commit it.
ANTHROPIC_API_KEY=
# Optional: the model (default claude-haiku-5-5), a daily cap per server instance (default 400), CHECKIN_AI=off to disable.
# CHECKIN_AI_MODEL=claude-haiku-5-5
# CHECKIN_AI_DAILY_CAP=400
